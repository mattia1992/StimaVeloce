<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Titolo del dialog -->
    <TextView
        android:id="@+id/title_alert_nuovo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />

    <!-- Campo di testo per il numero -->
    <EditText
        android:id="@+id/nome_file"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.4"
        android:hint="@string/edit"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="0.5"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <CheckBox
            android:id="@+id/checklarice"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/checklarice"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="tariffa"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
        <Spinner
            android:id="@+id/tariffa_larice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="0.5"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <CheckBox
            android:id="@+id/checkabete"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/checkabete"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="tariffa"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
        <Spinner
            android:id="@+id/tariffa_abete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="0.5"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <CheckBox
            android:id="@+id/checkfaggio"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/checkfaggio"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="tariffa"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
        <Spinner
            android:id="@+id/tariffa_faggio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="0.5"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <CheckBox
            android:id="@+id/checkabetebianco"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/checkabeteb"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="tariffa"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
        <Spinner
            android:id="@+id/tariffa_abeteb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="0.5"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <CheckBox
            android:id="@+id/checkpinosilvestre"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/checkpinos"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="tariffa"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
        <Spinner
            android:id="@+id/tariffa_pinos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="0.5"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <CheckBox
            android:id="@+id/checkpinocembro"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/checkpinoc"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="tariffa"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
        <Spinner
            android:id="@+id/tariffa_pinoc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="0.5"
        android:paddingTop="5dp">
        <CheckBox
            android:id="@+id/checkpinonero"
            android:layout_width="0dp"
            android:layout_weight="0.4"
            android:layout_height="wrap_content"
            android:text="@string/checkpinon"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="tariffa"
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
        <Spinner
            android:id="@+id/tariffa_pinon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text=""
            android:textColor="?android:attr/textColorPrimary"
            android:textAlignment="center"
            android:textSize="20dp"
            />
    </LinearLayout>
</LinearLayout>